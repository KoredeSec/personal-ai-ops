# Copy to .env and fill in. Never commit .env.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (get it from @userinfobot). Comma-separate for several.
TELEGRAM_ALLOWED_USER_IDS=
RATE_LIMIT_PER_MINUTE=20

# --- Gemini (https://aistudio.google.com/apikey - free tier is sufficient) ----
GEMINI_API_KEY=
# Model names are configurable; check current free-tier models at
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_LIGHT=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=4
GEMINI_MAX_OUTPUT_TOKENS=4096
# GEMINI_THINKING_BUDGET=0
GEMINI_DAILY_REQUEST_BUDGET=200
GEMINI_MAX_PROMPT_CHARS=30000
LLM_CACHE_TTL_HOURS=24

# --- Runtime ------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Africa/Lagos

# --- Database -----------------------------------------------------------------
# Default (unset) is SQLite at ./data/app.db. Docker sets sqlite:////app/data/app.db.
# PostgreSQL later: postgresql+psycopg://user:pass@host:5432/personal_ai_ops
# DATABASE_URL=

# --- Docker -------------------------------------------------------------------
# Host uid/gid that owns ./data (run `id -u` / `id -g`). Used by docker-compose.
APP_UID=1000
APP_GID=1000
